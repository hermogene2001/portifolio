# Local development: copy this file to .env.local and fill in the real values.
# Vercel: add the same variables in Project -> Settings -> Environment
# Variables for Production, Preview, and Development.
#
# DATABASE_URL: your PostgreSQL connection string.
#   Works with any PostgreSQL 14+ (Neon, Supabase, Railway, or local).
#   For hosted/serverless providers, use their pooled connection string when
#   available (Neon's host contains "-pooler") and keep "?sslmode=require".
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ADMIN_PASSWORD: the password for the /admin content editor.
ADMIN_PASSWORD=change-me-to-a-strong-password

# Contact form email (Gmail SMTP via Nodemailer).
# GMAIL_USER: the Gmail address that sends the messages.
# GMAIL_APP_PASSWORD: a 16-character Google "App Password" for that account.
#   Create one at https://myaccount.google.com/apppasswords
#   (requires 2-Step Verification to be enabled on the Google account).
# CONTACT_TO: where messages are delivered (optional; defaults to GMAIL_USER).
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
CONTACT_TO=you@gmail.com
